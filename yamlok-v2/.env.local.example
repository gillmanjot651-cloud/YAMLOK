# ─── ADMIN AUTH ───────────────────────────────────────────────────────────────
# Secret key for signing the session cookie. Make it 32+ random characters.
NEXTAUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars

# The full URL where your site runs (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# Password your friend uses to log into /admin
ADMIN_PASSWORD=yamlok2025

# One-time recovery token — share this with your friend so they can reset
# their own password from the login page if they forget it.
# Change this to any random string. Keep it secret.
RESET_TOKEN=change-this-to-a-secret-recovery-token

# ─── GITHUB PUBLISHING ────────────────────────────────────────────────────────
# Personal Access Token with `repo` scope
# Create one: https://github.com/settings/tokens/new?scopes=repo
GITHUB_TOKEN=ghp_your_token_here

# Your repo in owner/repo format
GITHUB_REPO=YamRajSingh13/yamlok-v2

# Branch to publish to
GITHUB_BRANCH=main

# Path of the media file INSIDE the repo
GITHUB_MEDIA_PATH=public/media.json

# ─── VISITOR ANALYTICS (Upstash Redis — free) ────────────────────────────────
# 1. Go to https://upstash.com → Create Database → Redis → free tier
# 2. Open the database → REST API tab → copy the two values below
UPSTASH_REDIS_REST_URL=https://xxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ─── IMGBB IMAGE UPLOAD ───────────────────────────────────────────────────────
# Free key from https://api.imgbb.com/
IMGBB_API_KEY=your_imgbb_key_here
